# Copiar este archivo como ".env" para desarrollo local (no se sube a git).
# Para el APK, cargar los mismos valores en GitHub → Settings → Secrets and variables → Actions.

# Supabase → Project Settings → API (o "Connect") → Project URL
VITE_SUPABASE_URL="https://edfekwyidzpdujhbndln.supabase.co"

